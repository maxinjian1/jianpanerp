
# ---- 商品販売ショート動画（tools/product-video）----
KLING_BASE_URL=https://api.klingai.com
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_MODEL=kling-v2-1
KLING_MODE=std
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=2
VIDEO_FONT=C:/Windows/Fonts/YuGothB.ttc
VIDEO_BGM=

# 楽天 RMS WEB API（R-Cabinet 棚卸し/圧縮 tools/rakuten/cabinet.mjs）。RMS → 拡張サービス → WEB APIサービス で用户本人が発行、ここには書かない
RAKUTEN_SERVICE_SECRET=
RAKUTEN_LICENSE_KEY=

# Instagram（tools/instagram/ig.mjs）。長期トークンは用户本人が Meta for Developers で発行、ここには書かない
META_APP_ID=
META_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_HANDLE=
FB_PAGE_ID=              # setup が自動追記：Instagram にリンクした Facebook ページ（publish が同時投稿）
FB_PAGE_TOKEN=
FB_PAGE_NAME=
THREADS_APP_SECRET=       # Meta アプリの Threads ユースケース設定にある「Threads アプリシークレット」（用户が自分で記入）
THREADS_ACCESS_TOKEN=     # Threads ユーザートークン（th-setup が長期に交換して上書き）
THREADS_USER_ID=          # th-setup が自動記入
THREADS_HANDLE=
THREADS_TOKEN_AT=
ANET_SITE=https://anetmc.com
# 6kpro 停止時の代行（2026-11-01 用户決定）：Windows の Ollama。LLM_LOCAL_FALLBACK=0 で無効
LOCAL_LLM_MODEL=qwen3:30b-a3b
LOCAL_LLM_VISION_MODEL=qwen2.5vl:7b
LLM_LOCAL_FALLBACK=1
